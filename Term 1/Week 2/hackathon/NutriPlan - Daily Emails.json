              "value": "=<div style=\"font-family: Arial, sans-serif; max-width: 650px; margin: auto; color: #333;\">\n\n  <div style=\"background: #4CAF50; padding: 25px; border-radius: 12px 12px 0 0; color: white;\">\n    <h1 style=\"margin: 0;\">🥗 Your Daily Meal Plan</h1>\n    <p style=\"margin-bottom: 0;\">{{ $json.day }}</p>\n  </div>\n\n  <div style=\"padding: 25px; border: 1px solid #ddd; border-top: none;\">\n\n    <h2>🍳 Breakfast</h2>\n    <p>{{ $json.breakfast }}</p>\n\n    <h2>🥗 Lunch</h2>\n    <p>{{ $json.lunch }}</p>\n\n    <h2>🍽️ Dinner</h2>\n    <p>{{ $json.dinner }}</p>\n\n    <h2>🍎 Healthy Snack</h2>\n    <p>{{ $json.snack }}</p>\n\n    <h2>🛒 Ingredients to Buy</h2>\n    <p>• {{ $json.ingredients_to_buy.join('<br>• ') }}</p>\n\n    <h2>🧠 Daily Well-being Tip</h2>\n    <p>{{ $json.daily_wellbeing_tip }}</p>\n\n    <hr>\n\n    <p style=\"font-size: 13px; color: #888;\">\n      This meal plan was automatically generated by NutriPlan AI.\n    </p>\n\n  </div>\n\n</div>",
