    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\n\n// Get the weekly plan directly\nconst weeklyPlanText = String(row.weekly_plan || \"\");\n\nif (!weeklyPlanText) {\n  throw new Error(\"The weekly_plan field is empty.\");\n}\n\n// Determine today's day\nconst today = new Date().toLocaleDateString(\"en-US\", {\n  weekday: \"long\"\n});\n\n// Remove Markdown code fences if they exist\nconst cleanedPlan = weeklyPlanText\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\n// Convert to JSON\nlet weeklyPlan;\n\ntry {\n  weeklyPlan = JSON.parse(cleanedPlan);\n} catch (error) {\n  throw new Error(\n    \"The weekly_plan exists but could not be converted to JSON. \" +\n    \"First characters: \" + cleanedPlan.substring(0, 150)\n  );\n}\n\n// Find today's meals\nconst todayPlan = weeklyPlan[today];\n\nif (!todayPlan) {\n  throw new Error(\n    `No meal plan found for ${today}. Available days: ` +\n    Object.keys(weeklyPlan).join(\", \")\n  );\n}\n\n// Return today's plan\nreturn [{\n  json: {\n    email: row.email,\n    day: today,\n    breakfast: todayPlan.breakfast,\n    lunch: todayPlan.lunch,\n    dinner: todayPlan.dinner,\n    snack: todayPlan.snack,\n    ingredients_to_buy: todayPlan.ingredients_to_buy,\n    daily_wellbeing_tip: todayPlan.daily_wellbeing_tip\n  }\n}];"
      },
